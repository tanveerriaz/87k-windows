{
  "name": "87k-windows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.x"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"PORT=3001 tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "start": "node dist/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:generate": "node scripts/generate-assets.mjs",
    "demo:gemma": "./scripts/run-demo.sh gemma",
    "demo:mock": "./scripts/run-demo.sh mock",
    "demo:local": "./scripts/run-demo.sh local",
    "verify:machine": "./scripts/verify-demo-machine.sh",
    "build:client": "vite build",
    "build:server": "tsup src/server/index.ts --format esm --platform node --target node22 --out-dir dist/server --clean false",
    "build": "npm run build:client && npm run build:server"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "minisearch": "^7.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
